# Copia este archivo a .env y llénalo. NUNCA subas .env a GitHub.

# Wallet que crea tandas y revela el sorteo (recomendado: un multisig Safe)
ADMIN_ADDRESS=0x...

# RPCs (Alchemy, Infura o los públicos de cada red)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=

# Una sola API key de Etherscan v2 sirve para verificar en las tres redes
ETHERSCAN_API_KEY=

# Para crear / revelar tandas
TANDA_MANAGER=0x...
# Secreto de 32 bytes. Genera uno con:  cast keccak "$(openssl rand -hex 32)"
# GUÁRDALO: sin él no puedes revelar el sorteo y la tanda se cancela a los 3 días.
TANDA_SEED=0x...
TANDA_ID=1

# Opcionales al crear (valores por defecto entre paréntesis)
# TANDA_MEMBERS=10               (10 personas)
# TANDA_CONTRIBUTION=15000000    (15 USDC, 6 decimales)
# TANDA_COLLATERAL=30000000      (30 USDC de garantía)
# TANDA_PERIOD_SECONDS=604800    (1 semana)
# TANDA_PERIODS_PER_ROUND=4      (cobro cada 4 semanas)
# TANDA_GRACE_SECONDS=172800     (2 días de gracia)
# TANDA_JOIN_DEADLINE=0          (timestamp límite para llenarse; 0 = sin límite)
# TANDA_INVITED=0xabc...,0xdef...  (vacío = abierta)
