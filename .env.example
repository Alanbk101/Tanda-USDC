# Variables opcionales del sitio (Vite). Copia a .env.local para desarrollo.

# Dirección de TandaManager por red (alternativa a editar src/config/deployments.ts)
# VITE_TANDA_MANAGER_84532=0x...   # Base Sepolia
# VITE_TANDA_MANAGER_421614=0x...  # Arbitrum Sepolia
# VITE_TANDA_MANAGER_80002=0x...   # Polygon Amoy

# RPC propio por red (si el público va lento). Ej. Alchemy:
# VITE_RPC_84532=https://base-sepolia.g.alchemy.com/v2/<key>

# WalletConnect (MetaMask móvil, Trust Wallet...). Gratis en https://cloud.reown.com
# VITE_WALLETCONNECT_PROJECT_ID=

# Desarrollo local con anvil (ver contracts/evm/README.md, "Probar la app en local")
# VITE_ENABLE_LOCAL=true
# VITE_LOCAL_USDC=0x...
# VITE_TANDA_MANAGER_31337=0x...
# VITE_RPC_31337=http://127.0.0.1:8545
